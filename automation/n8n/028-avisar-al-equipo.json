        "jsCode": "const destinos = [\n  '5491128885877', // Jero - depósito\n  '5491136488085', // Bauti - depósito\n  '5491135695077', // Marcos - web\n  '5491125600028', // Lucio\n];\nconst texto = $('Armar aviso').first().json.texto;\nreturn destinos.map((numero) => ({ json: { chatId: numero + '@c.us', texto } }));"
