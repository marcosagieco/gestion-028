{
  "name": "028 - aviso de entrega al cliente",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "entrega-cliente",
        "options": {}
      },
      "id": "e1111111-1111-4111-8111-111111111111",
      "name": "Webhook entrega",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        -48
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "m1",
              "name": "telefono",
              "type": "string",
              "value": "={{ String($('Webhook entrega').item.json.body.telefono || '').replace(/\\D/g, '') }}"
            },
            {
              "id": "m2",
              "name": "texto",
              "type": "string",
              "value": "={{ $('Webhook entrega').item.json.body.evento === 'entregado' ? ($json.plantillas?.GRACIAS || 'listo, te lo entregamos! que lo disfrutes ❤️') : 'el repartidor ya llegó a la dirección 🛵 salí a recibirlo' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "e3333333-3333-4333-8333-333333333333",
      "name": "Armar mensaje",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        448,
        -48
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "propertyName": "conversationId",
        "key": "=conv:{{ $json.telefono }}",
        "options": {}
      },
      "id": "e4444444-4444-4444-8444-444444444444",
      "name": "Buscar conversacion",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        672,
        -48
      ],
      "credentials": {
        "redis": {
          "name": "Redis"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.conversationId }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e5555555-5555-4555-8555-555555555555",
      "name": "Hay conversacion?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        896,
        -48
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://chatwoot.bunge.agenticsia.agency/api/v1/accounts/1/conversations/{{ $json.conversationId }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": {{ JSON.stringify($('Armar mensaje').item.json.texto) }},\n  \"message_type\": \"outgoing\",\n  \"private\": false\n}",
        "options": {}
      },
      "id": "e6666666-6666-4666-8666-666666666666",
      "name": "Enviar al cliente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1104,
        -128
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Chatwoot API (completar token)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "0e621eba-2ca1-4277-ba22-37e142c2832b",
      "name": "Leer plantillas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        224,
        -48
      ],
      "parameters": {
        "url": "https://us-central1-gestion-028.cloudfunctions.net/agentEstadoOperativo",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "028 Agent API (X-Agent-Key)"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    }
  ],
  "connections": {
    "Armar mensaje": {
      "main": [
        [
          {
            "node": "Buscar conversacion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar conversacion": {
      "main": [
        [
          {
            "node": "Hay conversacion?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hay conversacion?": {
      "main": [
        [
          {
            "node": "Enviar al cliente",
            "type": "main",
            "index": 0
          }
        ]
